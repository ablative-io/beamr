select(.reason == "compiler-message") | select(.message.level == "error" or .message.level == "warning") | {type: "clippy", level: .message.level, file: ([.message.spans[]? | select(.is_primary)][0].file_name // .message.spans[0]?.file_name // "unknown"), line: ([.message.spans[]? | select(.is_primary)][0].line_start // .message.spans[0]?.line_start // null), lint: (.message.code.code // "compile-error"), message: .message.message}
